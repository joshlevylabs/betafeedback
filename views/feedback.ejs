<body>
  <%- include('partials/menu', { isAdmin: user.is_admin }) %>
  <div class="main-content">
    <%- include('partials/header') %>
    <h1>Submit General Feedback</h1>
    <div class="button-container">
      <a href="#" id="feedbackButton" class="button">
        <i class="fas fa-comment"></i> UA-125 & UA-125 ARC Feedback
      </a>
    </div>
  </div>
  <script>
    window.ATL_JQ_PAGE_PROPS = {
      "triggerFunction": function(showCollectorDialog) {
        document.getElementById("feedbackButton").addEventListener("click", function(e) {
          e.preventDefault();
          showCollectorDialog();
        });
      }
    };
  </script>
  <script src="https://sonancelabs.atlassian.net/s/d41d8cd98f00b204e9800998ecf8427e-T/g2slup/b/9/c95134bc67d3a521bb3f4331beb9b804/_/download/batch/com.atlassian.jira.collector.plugin.jira-issue-collector-plugin:issuecollector/com.atlassian.jira.collector.plugin.jira-issue-collector-plugin:issuecollector.js?locale=en-US&collectorId=c76f517d"></script>
