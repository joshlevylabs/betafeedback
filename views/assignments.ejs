<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Assignments - SONANCE Beta Program</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/menu', { isAdmin: user.is_admin }) %>
  <div class="main-content">
    <%- include('partials/header') %>
    <h1>Homework Assignments</h1>

    <h2>Uncompleted Assignments</h2>
    <div class="assignment-container">
      <% uncompleted.forEach(assignment => { %>
        <div class="assignment-card unsubmitted" onclick="location.href='/assignment/<%= assignment.id %>'">
          <i class="fas fa-book assignment-icon"></i>
          <div class="assignment-title"><%= assignment.title %></div>
          <div class="assignment-status">Not Submitted</div>
          <p><%= assignment.description %></p>
          <div class="assignment-date">Created: <%= new Date(assignment.created_at).toLocaleDateString() %></div>
          <div class="assignment-groups">Group: <%= assignment.group_name || 'N/A' %></div>
        </div>
      <% }) %>
    </div>

    <h2>Completed Assignments</h2>
    <div class="assignment-container">
      <% completed.forEach(assignment => { %>
        <div class="assignment-card submitted" onclick="location.href='/assignment/<%= assignment.id %>'">
          <i class="fas fa-book assignment-icon"></i>
          <div class="assignment-title"><%= assignment.title %></div>
          <div class="assignment-status">Submitted</div>
          <p><%= assignment.description %></p>
          <div class="assignment-date">Created: <%= new Date(assignment.created_at).toLocaleDateString() %></div>
          <div class="assignment-groups">Group: <%= assignment.group_name || 'N/A' %></div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>