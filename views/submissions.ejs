<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Submissions - SONANCE Beta Program</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
    }
    .main-content {
      padding: 20px;
    }
    .button {
      display: inline-block;
      padding: 5px 10px;
      background-color: #1e94c2;
      color: white;
      text-decoration: none;
      border-radius: 5px;
    }
    .button:hover {
      background-color: #167a9e;
    }
  </style>
</head>
<body>
  <%- include('partials/menu', { isAdmin: user.is_admin }) %>
  <div class="main-content">
    <%- include('partials/header') %>
    <h1>Submissions</h1>
    <% assignments.forEach(assignment => { %>
      <h2><%= assignment.title %></h2>
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Submitted At</th>
            <th>Time to Submit</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% assignment.submissions.forEach(submission => { %>
            <tr>
              <td><%= submission.user %></td>
              <td><%= submission.email %></td>
              <td><%= submission.submitted_at %></td>
              <td>
                <% const createdAt = new Date(assignment.created_at); %>
                <% const submittedAt = new Date(submission.submitted_at); %>
                <% const timeDiff = submittedAt - createdAt; %>
                <% if (timeDiff >= 0) { %>
                  <% const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24)); %>
                  <% const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)); %>
                  <% const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60)); %>
                  <%= days %>d <%= hours %>h <%= minutes %>m
                <% } else { %>
                  Not Available
                <% } %>
              </td>
              <td>
                <a href="/submissions/<%= submission.submission_id %>/details" class="button">View Details</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% }) %>
  </div>
</body>
</html>