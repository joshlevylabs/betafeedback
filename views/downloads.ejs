<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Downloads - SONANCE Beta Program</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>
  <%- include('partials/menu', { isAdmin: user.is_admin }) %>
  <div class="main-content">
    <h1>Downloads</h1>
    <% if (groups.length === 0) { %>
      <p>You are not a member of any group.</p>
    <% } else { %>
      <% groups.forEach(group => { %>
        <h2><%= group.name %></h2>
        <% if (group.files.length === 0) { %>
          <p>No files available for this group.</p>
        <% } else { %>
          <div class="button-container">
            <% group.files.forEach(file => { %>
              <a href="<%= file.is_link ? file.file_path : '/uploads/' + file.file_path %>" class="button" <%= file.is_link ? 'download' : '' %>>
                <i class="fas fa-<%= file.is_link ? 'link' : 'file-pdf' %>"></i> <%= file.file_name %>
              </a>
            <% }) %>
          </div>
        <% } %>
        <% if (user.is_admin) { %>
          <h3>Upload File</h3>
          <form action="/admin/groups/<%= group.id %>/upload" method="POST" enctype="multipart/form-data">
            <input type="file" name="file" required>
            <button type="submit" class="button">Upload File</button>
          </form>
          <h3>Add Download Link</h3>
          <form action="/admin/groups/<%= group.id %>/add-link" method="POST">
            <label for="title">Title:</label>
            <input type="text" name="title" required>
            <label for="link">Link URL:</label>
            <input type="url" name="link" required>
            <button type="submit" class="button">Add Link</button>
          </form>
        <% } %>
      <% }) %>
    <% } %>
  </div>
</body>
</html>