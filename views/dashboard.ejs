<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Dashboard - SONANCE Beta Program</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <style>
    .main-content > h1,
    .main-content p,
    .main-content a.button {
      margin-bottom: 20px;
    }
    .user-info {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
    }
    .profile-image {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 15px;
      border: 2px solid #333;
    }
  </style>
</head>
<body>
  <%- include('partials/menu', { isAdmin: user.is_admin }) %>
  <div class="main-content">
    <%- include('partials/header') %>
    <div class="user-info">
      <% if (user.profile_image) { %>
        <img src="<%= user.profile_image %>" alt="Profile Image" class="profile-image">
      <% } else { %>
        <i class="fas fa-user-circle profile-image" style="font-size: 50px; color: #666;"></i>
      <% } %>
      <h1>Welcome to Your Dashboard, <%= user.name %></h1>
    </div>
    <p>Email: <%= user.email %></p>
    <a href="/profile/edit" class="button">Edit Profile</a>

    <h2>Your Groups</h2>
    <ul class="group-icons">
      <% groups.forEach(group => { %>
        <li>
          <a href="/groups/<%= group.id %>" class="group-link">
            <i class="fas fa-users"></i>
            <span class="group-name"><%= group.name %></span>
          </a>
        </li>
      <% }) %>
    </ul>

    <h2>Your Assignments</h2>

    <h3>Unsubmitted Assignments</h3>
    <div class="assignment-container">
      <% unsubmitted.forEach(assignment => { %>
        <div class="assignment-card unsubmitted" onclick="location.href='/assignment/<%= assignment.id %>'">
          <i class="fas fa-book assignment-icon"></i>
          <div class="assignment-title"><%= assignment.title %></div>
          <div class="assignment-status">Not Submitted</div>
          <p><%= assignment.description %></p>
          <div class="assignment-date">Created: <%= new Date(assignment.created_at).toLocaleDateString() %></div>
          <div class="assignment-groups">Group: <%= assignment.group_name || 'N/A' %></div>
        </div>
      <% }) %>
    </div>

    <h3>Submitted Assignments</h3>
    <div class="assignment-container">
      <% submitted.forEach(assignment => { %>
        <div class="assignment-card submitted" onclick="location.href='/assignment/<%= assignment.id %>'">
          <i class="fas fa-book assignment-icon"></i>
          <div class="assignment-title"><%= assignment.title %></div>
          <div class="assignment-status">Submitted</div>
          <p><%= assignment.description %></p>
          <div class="assignment-date">Created: <%= new Date(assignment.created_at).toLocaleDateString() %></div>
          <div class="assignment-groups">Group: <%= assignment.group_name || 'N/A' %></div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>