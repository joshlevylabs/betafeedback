<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Manage All FAQs - SONANCE Beta Program</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/menu', { isAdmin: user.is_admin }) %>
  <div class="main-content">
    <%- include('partials/header') %>
    <h1>All FAQs</h1>
    <% if (faqs.length > 0) { %>
      <% faqs.forEach(faq => { %>
        <div class="faq-item">
          <h3><%= faq.group_name %>: <%= faq.question %></h3>
          <p><%= faq.answer %></p>
          <a href="/admin/groups/<%= faq.group_id %>/faqs/<%= faq.id %>/edit" class="button">Edit</a>
          <form action="/admin/groups/<%= faq.group_id %>/faqs/<%= faq.id %>/delete" method="POST" style="display:inline;">
            <button type="submit" class="button delete">Delete</button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <p>No FAQs available.</p>
    <% } %>
    <a href="/admin/groups" class="button">Back to Groups</a>
  </div>
</body>
</html>