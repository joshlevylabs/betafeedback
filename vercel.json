{
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(html|css|js|png|jpg|ico))",
      "dest": "/public/$1"
    },
    {
      "src": "/.*",
      "dest": "/api/server"
    }
  ]
}